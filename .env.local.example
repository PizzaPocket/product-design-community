# Copy to .env.local for local development, and set the same values in Vercel's
# project environment variables for production.

# Resend API key — from https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (Settings > Domains).
# Until the domain is verified, use Resend's shared test address:
#   RESEND_FROM_EMAIL=onboarding@resend.dev
# (only delivers to the email on your own Resend account until verified)
RESEND_FROM_EMAIL=
